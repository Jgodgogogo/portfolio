# 使用官方 Node.js 镜像
FROM node:20-alpine AS base

# 安装兼容库（某些依赖需要）
RUN apk add --no-cache libc6-compat

# 设置工作目录
WORKDIR /app

# 拷贝依赖文件并安装
COPY package*.json ./
RUN npm ci

# 拷贝项目文件
COPY . .

# 构建项目
RUN npm run build

# 设置生产环境
ENV NODE_ENV=production
EXPOSE 3000

# 启动服务
CMD ["node", ".next/standalone/server.js"]

